local activeTab = "ESP"
local tabButtons = {}

local function createTabButton(text, icon, order, tabName)
	local btn = create("TextButton", {
		Name = tabName .. "Tab",
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = Theme.Card,
		Text = "",
		LayoutOrder = order,
		Parent = tabContainer
	})
	addCorner(btn, 10)
	addStroke(btn, Theme.Border, 1)
	
	local indicator = create("Frame", {
		Size = UDim2.new(0, 3, 0, 0),
		Position = UDim2.new(0, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = btn
	})
	addCorner(indicator, 2)
	
	local iconLabel = create("TextLabel", {
		Size = UDim2.new(0, 30, 1, 0),
		Position = UDim2.new(0, 15, 0, 0),
		BackgroundTransparency = 1,
		Text = icon,
		TextColor3 = Theme.TextSecondary,
		Font = FontBold,
		TextSize = 16,
		Parent = btn
	})
	
	local textLabel = create("TextLabel", {
		Size = UDim2.new(1, -55, 1, 0),
		Position = UDim2.new(0, 50, 0, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = Theme.TextSecondary,
		Font = FontBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = btn
	})
	
	local function setActive(active)
		TweenService:Create(btn, TweenInfo.new(0.2), {
			BackgroundColor3 = active and Theme.CardHover or Theme.Card
		}):Play()
		TweenService:Create(indicator, TweenInfo.new(0.2), {
			Size = active and UDim2.new(0, 3, 0, 24) or UDim2.new(0, 3, 0, 0)
		}):Play()
		TweenService:Create(textLabel, TweenInfo.new(0.2), {
			TextColor3 = active and Theme.TextPrimary or Theme.TextSecondary
		}):Play()
		TweenService:Create(iconLabel, TweenInfo.new(0.2), {
			TextColor3 = active and Theme.Accent or Theme.TextSecondary
		}):Play()
	end
	
	btn.MouseEnter:Connect(function()
		if activeTab ~= tabName then
			TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.CardHover}):Play()
		end
	end)
	btn.MouseLeave:Connect(function()
		if activeTab ~= tabName then
			TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Card}):Play()
		end
	end)
	
	btn.MouseButton1Click:Connect(function()
		if activeTab == tabName then return end
		activeTab = tabName
		
		for name, data in pairs(tabButtons) do
			data.setActive(name == tabName)
		end
		
		espPage.Visible = (tabName == "ESP")
		updatePage.Visible = (tabName == "Update")
		discordPage.Visible = (tabName == "Discord")
	end)
	
	tabButtons[tabName] = { setActive = setActive }
	setActive(tabName == activeTab)
	return btn
end

