local function showPopup()
	popupOverlay.Visible = true
	popupOverlay.BackgroundTransparency = 1
	popupCard.Size = UDim2.new(0, 0, 0, 0)
	TweenService:Create(popupOverlay, TweenInfo.new(0.25), {BackgroundTransparency = 0.55}):Play()
	TweenService:Create(popupCard, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 420, 0, 240)}):Play()
end

local function hidePopup(callback)
	local tween = TweenService:Create(popupCard, TweenInfo.new(0.2), {Size = UDim2.new(0, 0, 0, 0)})
	TweenService:Create(popupOverlay, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
	tween:Play()
	tween.Completed:Connect(function()
		popupOverlay.Visible = false
		if callback then callback() end
	end)
end

