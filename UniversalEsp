local function makeColorSlider(btn, fill, colorIndex)
	local draggingColor = false
	local function update(input)
		local pos = math.clamp((input.Position.X - fill.Parent.AbsolutePosition.X) / fill.Parent.AbsoluteSize.X, 0, 1)
		fill.Size = UDim2.new(pos, 0, 1, 0)
		if colorIndex == 1 then r = pos elseif colorIndex == 2 then g = pos else b = pos end
		updateColor()
	end
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			draggingColor = true; update(input)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if draggingColor and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingColor = false end
	end)
end

