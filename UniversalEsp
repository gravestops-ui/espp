local espCache = {}

local function createESP(player)
	if player == LocalPlayer then return end
	
	local highlight = Instance.new("Highlight")
	highlight.FillColor = Config.ESP.Color
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = 0.5
	highlight.OutlineTransparency = 0
	highlight.Adornee = nil
	highlight.Enabled = false
	highlight.Parent = screenGui
	
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 200, 0, 60)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Adornee = nil
	billboard.Enabled = false
	billboard.Parent = screenGui
	
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 0, 20)
	nameLabel.BackgroundTransparency = 1
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLabel.TextStrokeTransparency = 0
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextSize = 14
	nameLabel.Parent = billboard
	
	local distLabel = Instance.new("TextLabel")
	distLabel.Size = UDim2.new(1, 0, 0, 15)
	distLabel.Position = UDim2.new(0, 0, 0, 20)
	distLabel.BackgroundTransparency = 1
	distLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	distLabel.TextStrokeTransparency = 0
	distLabel.Font = Enum.Font.Gotham
	distLabel.TextSize = 12
	distLabel.Parent = billboard
	
	local healthBar = Instance.new("Frame")
	healthBar.Size = UDim2.new(0, 4, 1, 0)
	healthBar.Position = UDim2.new(-0.1, 0, 0, 0)
	healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
	healthBar.BorderSizePixel = 0
	healthBar.Parent = billboard
	local hbCorner = Instance.new("UICorner", healthBar)
	hbCorner.CornerRadius = UDim.new(0, 2)

	local tracer = Instance.new("Frame")
	tracer.Size = UDim2.new(0, 1, 0, 1)
	tracer.BackgroundColor3 = Config.ESP.Color
	tracer.BorderSizePixel = 0
	tracer.AnchorPoint = Vector2.new(0, 0.5)
	tracer.Visible = false
	tracer.Parent = screenGui

	espCache[player] = {
		highlight = highlight, 
		billboard = billboard, 
		nameLabel = nameLabel, 
		distLabel = distLabel, 
		healthBar = healthBar,
		tracer = tracer
	}
end

local function removeESP(player)
	if espCache[player] then
		espCache[player].highlight:Destroy()
		espCache[player].billboard:Destroy()
		espCache[player].tracer:Destroy()
		espCache[player] = nil
	end
end

Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)
for _, p in pairs(Players:GetPlayers()) do createESP(p) end

RunService.Heartbeat:Connect(function()
	for player, esp in pairs(espCache) do
		if esp.highlight then
			esp.highlight.FillColor = Config.ESP.Color
			esp.tracer.BackgroundColor3 = Config.ESP.Color
		end
	end
end)

RunService.RenderStepped:Connect(function()
	for player, esp in pairs(espCache) do
		local character = player.Character
		if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 and Config.ESP.Enabled then
			
			if Config.ESP.TeamCheck and player.Team == LocalPlayer.Team then
				esp.highlight.Enabled = false
				esp.billboard.Enabled = false
				esp.tracer.Visible = false
				continue
			end

			local hrp = character.HumanoidRootPart
			local dist = math.floor((Camera.CFrame.Position - hrp.Position).Magnitude)
			
			if dist > Config.ESP.MaxDistance then
				esp.highlight.Enabled = false
				esp.billboard.Enabled = false
				esp.tracer.Visible = false
				continue
			end
			
			esp.highlight.Enabled = Config.ESP.Box
			esp.highlight.Adornee = character
			
			esp.billboard.Enabled = Config.ESP.Name or Config.ESP.Distance or Config.ESP.Health
			esp.billboard.Adornee = hrp
			
			esp.nameLabel.Visible = Config.ESP.Name
			esp.nameLabel.Text = player.Name
			
			esp.distLabel.Visible = Config.ESP.Distance
			esp.distLabel.Text = dist .. " studs"
			
			if Config.ESP.Health then
				esp.healthBar.Visible = true
				local healthPercent = character.Humanoid.Health / character.Humanoid.MaxHealth
				esp.healthBar.Size = UDim2.new(0, 4, healthPercent, 0)
				esp.healthBar.Position = UDim2.new(-0.1, 0, 1 - healthPercent, 0)
				esp.healthBar.BackgroundColor3 = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
			else
				esp.healthBar.Visible = false
			end
			
			if Config.ESP.Tracers then
				local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
				if onScreen then
					local bottomCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
					local targetPos = Vector2.new(screenPos.X, screenPos.Y)
					
					local distance = (targetPos - bottomCenter).Magnitude
					local angle = math.atan2(targetPos.Y - bottomCenter.Y, targetPos.X - bottomCenter.X)
					
					esp.tracer.Visible = true
					esp.tracer.Size = UDim2.new(0, distance, 0, 1)
					esp.tracer.Position = UDim2.new(0.5, 0, 1, 0)
					esp.tracer.Rotation = math.deg(angle)
				else
					esp.tracer.Visible = false
				end
			else
				esp.tracer.Visible = false
			end
			
		else
			if esp.highlight then esp.highlight.Enabled = false end
			if esp.billboard then esp.billboard.Enabled = false end
			if esp.tracer then esp.tracer.Visible = false end
		end
	end
end)

